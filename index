<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>طرح پیشنهادی شروین آکادمی</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#07080c; --bg2:#0e1017; --card:#13161f; --line:#232735;
  --ink:#f4f5f7; --mute:#9aa0ad; --dim:#6b7180;
  --y:#ffc928; --y2:#ffb000; --yglow:rgba(255,201,40,.18);
  --ok:#3ddc97; --r:20px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Vazirmatn,Tahoma,sans-serif;background:var(--bg);color:var(--ink);line-height:1.8;overflow-x:hidden}
a{color:inherit;text-decoration:none}
.wrap{max-width:1200px;margin:0 auto;padding:0 20px}
.btn{display:inline-flex;align-items:center;gap:10px;font:inherit;font-weight:800;border:0;cursor:pointer;border-radius:14px;padding:15px 28px;transition:.25s}
.btn-y{background:var(--y);color:#111;box-shadow:0 10px 40px var(--yglow)}
.btn-y:hover{background:var(--y2);transform:translateY(-2px)}
.btn-o{background:transparent;color:var(--ink);border:1px solid var(--line)}
.btn-o:hover{border-color:var(--y);color:var(--y)}
.tag{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:var(--y);background:var(--yglow);border:1px solid rgba(255,201,40,.3);padding:6px 14px;border-radius:99px}
.tag i{width:7px;height:7px;border-radius:50%;background:var(--y);box-shadow:0 0 10px var(--y)}
h2.sec{font-size:clamp(28px,4vw,44px);font-weight:900;line-height:1.35;margin:14px 0 12px}
h2.sec em{font-style:normal;color:var(--y)}
p.lead{color:var(--mute);font-size:17px;max-width:620px}
section{padding:100px 0}
.center{text-align:center}.center p.lead{margin:0 auto}

/* concept ribbon */
.ribbon{background:var(--y);color:#111;font-size:13px;font-weight:700;text-align:center;padding:8px 16px}
.ribbon b{font-weight:900}

/* nav */
nav{position:sticky;top:0;z-index:50;background:rgba(7,8,12,.75);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:74px}
.logo{display:flex;align-items:center;gap:12px;font-weight:900;font-size:19px}
.logo .mk{width:42px;height:42px;border-radius:12px;background:var(--y);display:grid;place-items:center}
.logo small{display:block;font-size:11px;font-weight:500;color:var(--mute);margin-top:-6px}
.links{display:flex;gap:30px;font-size:15px;color:var(--mute);font-weight:500}
.links a:hover{color:var(--ink)}
nav .btn{padding:11px 20px;font-size:14px}
@media(max-width:900px){.links{display:none}}

/* hero */
.hero{padding:70px 0 90px;position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;inset:-200px -20% auto auto;width:700px;height:700px;background:radial-gradient(circle,rgba(255,201,40,.16),transparent 65%);pointer-events:none}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center}
.hero h1{font-size:clamp(38px,6vw,72px);font-weight:900;line-height:1.2;margin:22px 0}
.hero h1 span{color:var(--y);display:block}
.hero p.lead{font-size:18px;margin-bottom:34px}
.hero .ctas{display:flex;gap:14px;flex-wrap:wrap}
.proof{display:flex;align-items:center;gap:14px;margin-top:38px;color:var(--mute);font-size:14px}
.avs{display:flex}
.avs span{width:38px;height:38px;border-radius:50%;border:2px solid var(--bg);margin-left:-10px;background:linear-gradient(135deg,#2a2f3d,#454b5c);display:grid;place-items:center;font-size:13px;font-weight:800}
.avs span:last-child{background:var(--y);color:#111}
.stars{color:var(--y);letter-spacing:2px}
.visual{position:relative;aspect-ratio:4/5;border-radius:32px;background:
  linear-gradient(180deg,transparent 40%,rgba(7,8,12,.9)),
  repeating-linear-gradient(135deg,#151823 0 14px,#11141d 14px 28px);
  border:1px solid var(--line)}
.visual .ph{position:absolute;inset:0;display:grid;place-items:center;color:var(--dim);font-size:14px;text-align:center}
.visual .ph svg{opacity:.35;margin-bottom:8px}
.float{position:absolute;background:rgba(19,22,31,.9);backdrop-filter:blur(10px);border:1px solid var(--line);border-radius:18px;padding:14px 18px;box-shadow:0 20px 50px rgba(0,0,0,.5)}
.float b{font-size:22px;font-weight:900;color:var(--y);display:block;line-height:1.3}
.float small{color:var(--mute);font-size:12px}
.f1{top:28px;left:-28px}.f2{bottom:110px;right:-28px}
.f3{bottom:24px;left:24px;right:24px;display:flex;align-items:center;gap:14px}
.f3 .ic{width:44px;height:44px;border-radius:12px;background:var(--yglow);display:grid;place-items:center;flex:none}
@media(max-width:900px){.hero .wrap{grid-template-columns:1fr}.visual{max-width:440px;width:100%;margin:0 auto}.f1{left:10px}.f2{right:10px}}

/* stats */
.stats{border-block:1px solid var(--line);background:var(--bg2);padding:44px 0}
.stats .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.stat{text-align:center}
.stat b{font-size:clamp(30px,4vw,46px);font-weight:900;display:block;line-height:1.2}
.stat b sup{color:var(--y);font-size:.6em}
.stat span{color:var(--mute);font-size:14px}
@media(max-width:700px){.stats .wrap{grid-template-columns:1fr 1fr;gap:30px}}

/* steps */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:56px;counter-reset:s}
.step{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:28px;position:relative;transition:.3s}
.step:hover{border-color:rgba(255,201,40,.45);transform:translateY(-4px)}
.step::before{counter-increment:s;content:"۰" counter(s,persian);font-size:46px;font-weight:900;color:transparent;-webkit-text-stroke:1px #3a3f4f;position:absolute;top:14px;left:22px}
.step .ic{width:52px;height:52px;border-radius:14px;background:var(--yglow);display:grid;place-items:center;margin-bottom:20px}
.step h3{font-size:19px;font-weight:800;margin-bottom:8px}
.step p{color:var(--mute);font-size:14.5px}
@media(max-width:900px){.steps{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.steps{grid-template-columns:1fr}}

/* features bento */
.bento{display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:minmax(210px,auto);gap:18px;margin-top:56px}
.bx{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:30px;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden}
.bx h3{font-size:21px;font-weight:800;margin-bottom:6px}
.bx p{color:var(--mute);font-size:15px}
.bx.big{grid-column:span 2;grid-row:span 2;background:linear-gradient(160deg,#1b1f2b,#0f1118)}
.bx.big h3{font-size:30px}
.bx.yel{background:var(--y);color:#111}.bx.yel p{color:#3a3220}
.bx .ico{position:absolute;top:26px;right:26px}
.bigart{position:absolute;top:30px;left:30px;right:30px;display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.bigart div{aspect-ratio:16/9;border-radius:14px;background:#191d28;border:1px solid var(--line);display:grid;place-items:center;font-size:12px;color:var(--dim)}
.bigart div:nth-child(3n+1){background:rgba(255,201,40,.1);border-color:rgba(255,201,40,.25);color:var(--y)}
@media(max-width:900px){.bento{grid-template-columns:1fr}.bx.big{grid-column:auto;grid-row:auto;min-height:420px}}

/* results */
.results{background:var(--bg2)}
.rgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:56px}
.rc{background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.ba{display:grid;grid-template-columns:1fr 1fr;aspect-ratio:1/1;position:relative}
.ba div{display:grid;place-items:end center;padding-bottom:12px;font-size:12px;font-weight:700;color:var(--dim);background:repeating-linear-gradient(135deg,#171a24 0 10px,#141720 10px 20px)}
.ba div+div{background:repeating-linear-gradient(135deg,#1d1c16 0 10px,#191812 10px 20px);color:var(--y)}
.ba::after{content:"";position:absolute;inset:0 50%;border-left:2px solid var(--y)}
.badge{position:absolute;top:12px;right:12px;background:var(--y);color:#111;font-weight:900;font-size:13px;padding:4px 12px;border-radius:99px;z-index:2}
.rc .tx{padding:20px}
.rc h4{font-size:17px;font-weight:800}
.rc h4 small{color:var(--mute);font-weight:500;font-size:13px;margin-right:6px}
.rc p{color:var(--mute);font-size:14px;margin-top:8px;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
@media(max-width:1000px){.rgrid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.rgrid{grid-template-columns:1fr}}

/* quiz */
.quiz{background:linear-gradient(135deg,#171a24,#0f1118);border:1px solid var(--line);border-radius:28px;padding:50px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.opts{display:grid;gap:12px}
.opt{display:flex;align-items:center;gap:14px;background:var(--bg);border:1px solid var(--line);border-radius:14px;padding:16px 18px;cursor:pointer;font:inherit;color:var(--ink);font-weight:600;text-align:right;transition:.2s}
.opt:hover{border-color:#3a3f4f}
.opt.on{border-color:var(--y);background:rgba(255,201,40,.07)}
.opt .dot{width:20px;height:20px;border-radius:50%;border:2px solid #3a3f4f;flex:none}
.opt.on .dot{border:6px solid var(--y)}
.rec{margin-top:18px;padding:18px;border-radius:14px;background:var(--yglow);border:1px dashed rgba(255,201,40,.5);display:none}
.rec.show{display:block}
.rec b{color:var(--y)}
@media(max-width:900px){.quiz{grid-template-columns:1fr;padding:30px 22px}}

/* pricing */
.toggle{display:inline-flex;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:5px;margin-top:30px}
.toggle button{font:inherit;font-weight:700;border:0;background:none;color:var(--mute);padding:10px 24px;border-radius:10px;cursor:pointer}
.toggle button.on{background:var(--y);color:#111}
.toggle small{font-size:11px;background:var(--ok);color:#06281a;padding:1px 7px;border-radius:99px;margin-right:6px}
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:44px;align-items:start}
.plan{background:var(--card);border:1px solid var(--line);border-radius:24px;padding:32px;position:relative}
.plan.pop{border:2px solid var(--y);background:linear-gradient(180deg,rgba(255,201,40,.07),var(--card) 40%);transform:translateY(-12px)}
.plan .pill{position:absolute;top:-14px;right:50%;transform:translateX(50%);background:var(--y);color:#111;font-size:13px;font-weight:900;padding:4px 16px;border-radius:99px;white-space:nowrap}
.plan .nm{font-size:13px;letter-spacing:2px;color:var(--y);font-weight:800}
.plan h3{font-size:24px;font-weight:900;margin:4px 0 6px}
.plan .ds{color:var(--mute);font-size:14px;min-height:48px}
.price{margin:22px 0 6px;display:flex;align-items:baseline;gap:8px}
.price b{font-size:40px;font-weight:900;line-height:1}
.price span{color:var(--mute);font-size:14px}
.pw{color:var(--dim);font-size:13px;margin-bottom:22px}
.plan .btn{width:100%;justify-content:center}
.plan ul{list-style:none;margin-top:26px;display:grid;gap:12px}
.plan li{display:flex;gap:10px;font-size:14.5px;color:#d5d8de}
.plan li svg{flex:none;margin-top:5px}
.plan li.x{color:var(--dim)}
.plan .deliv{margin-top:22px;padding-top:18px;border-top:1px solid var(--line);font-size:13px;color:var(--mute);display:flex;gap:8px;align-items:center}
.guar{margin-top:36px;display:flex;gap:16px;align-items:center;justify-content:center;color:var(--mute);font-size:14px;flex-wrap:wrap}
.guar span{display:flex;align-items:center;gap:8px}
@media(max-width:1000px){.plans{grid-template-columns:1fr;max-width:480px;margin-inline:auto}.plan.pop{transform:none}}

/* coach */
.coach .wrap{display:grid;grid-template-columns:.85fr 1.15fr;gap:60px;align-items:center}
.coach .visual{aspect-ratio:1}
.creds{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:30px}
.cred{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;display:flex;gap:12px;align-items:center;font-size:14px;font-weight:600}
.cred .ic{width:40px;height:40px;border-radius:10px;background:var(--yglow);display:grid;place-items:center;flex:none}
@media(max-width:900px){.coach .wrap{grid-template-columns:1fr}.creds{grid-template-columns:1fr}}

/* blog */
.blog{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:50px}
.post{background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;transition:.3s}
.post:hover{transform:translateY(-4px);border-color:#3a3f4f}
.post .im{aspect-ratio:16/9;background:repeating-linear-gradient(135deg,#171a24 0 12px,#141720 12px 24px)}
.post .tx{padding:22px}
.post small{color:var(--y);font-weight:700;font-size:12px}
.post h4{font-size:17px;font-weight:800;margin:6px 0 8px;line-height:1.6}
.post p{color:var(--mute);font-size:14px}
@media(max-width:900px){.blog{grid-template-columns:1fr}}

/* faq */
.faq{max-width:820px;margin:50px auto 0;display:grid;gap:12px}
details{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px 24px}
details[open]{border-color:rgba(255,201,40,.4)}
summary{cursor:pointer;font-weight:700;font-size:16.5px;list-style:none;display:flex;justify-content:space-between;gap:16px}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";color:var(--y);font-size:24px;line-height:1;transition:.2s}
details[open] summary::after{transform:rotate(45deg)}
details p{color:var(--mute);margin-top:12px;font-size:15px}

/* final cta */
.final{margin:0 20px 100px;border-radius:32px;background:var(--y);color:#111;padding:80px 30px;text-align:center;position:relative;overflow:hidden}
.final::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(135deg,rgba(0,0,0,.04) 0 20px,transparent 20px 40px)}
.final>*{position:relative}
.final h2{font-size:clamp(30px,5vw,54px);font-weight:900;line-height:1.3}
.final p{font-size:18px;margin:14px auto 30px;max-width:560px;color:#3a3220}
.final .btn{background:#111;color:var(--y)}
.final .btn:hover{background:#000}

footer{border-top:1px solid var(--line);padding:50px 0 120px;color:var(--mute);font-size:14px}
footer .wrap{display:flex;justify-content:space-between;gap:30px;flex-wrap:wrap;align-items:center}

/* mobile sticky */
.mbar{position:fixed;bottom:0;left:0;right:0;z-index:60;background:rgba(7,8,12,.92);backdrop-filter:blur(12px);border-top:1px solid var(--line);padding:12px 16px;display:none;gap:10px}
.mbar .btn{flex:1;justify-content:center;padding:13px}
@media(max-width:700px){.mbar{display:flex}section{padding:70px 0}}

.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s,transform .7s}
.reveal.in{opacity:1;transform:none}
</style>
</head>
<body>

<div class="ribbon">طرح پیشنهادی بازطراحی سایت شروین آکادمی · نسخهٔ نمایشی، تصاویر و جزئیات نهایی نیستند</div>

<nav>
  <div class="wrap">
    <a href="#" class="logo">
      <span class="mk"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2.4" stroke-linecap="round"><path d="M8 7a4 4 0 0 1 8 0"/><path d="M6 10h12l-1.5 10h-9z"/></svg></span>
      <span>شروین آکادمی<small>مربی‌گری آنلاین علمی</small></span>
    </a>
    <div class="links">
      <a href="#how">روند کار</a><a href="#results">نتایج</a><a href="#plans">پکیج‌ها</a><a href="#coach">درباره شروین</a><a href="#faq">سؤالات</a><a href="#">مقالات</a>
    </div>
    <a href="#quiz" class="btn btn-y">مشاوره رایگان</a>
  </div>
</nav>

<header class="hero">
  <div class="wrap">
    <div>
      <span class="tag"><i></i> ظرفیت این ماه محدود است</span>
      <h1>بدنی قوی بساز،<span>بدون آسیب.</span></h1>
      <p class="lead">برنامهٔ تمرین و تغذیهٔ کاملاً اختصاصی، طراحی‌شده بر پایهٔ فیزیولوژی و بیومکانیک — با ارزیابی ویدئویی، تمرینات اصلاحی و پیگیری هفتگی مستقیم توسط شروین پناهگر.</p>
      <div class="ctas">
        <a href="#plans" class="btn btn-y">انتخاب پکیج و شروع
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 6l-6 6 6 6"/></svg></a>
        <a href="#quiz" class="btn btn-o">کدام پکیج مناسب من است؟</a>
      </div>
      <div class="proof">
        <div class="avs"><span>س</span><span>ا</span><span>م</span><span>+۵۴۰</span></div>
        <div><span class="stars">★★★★★</span><br>بیش از ۵۴۰ ورزشکار به ما اعتماد کرده‌اند</div>
      </div>
    </div>
    <div class="visual">
      <div class="ph"><div><svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-5-5L5 21"/></svg><br>عکس پرترهٔ حرفه‌ای شروین<br>(یا ویدئوی کوتاه بی‌صدا)</div></div>
      <div class="float f1"><b>+۱۵ سال</b><small>مربی‌گری در ایران و اروپا</small></div>
      <div class="float f2"><b>NASM</b><small>رویکرد آکادمی آمریکا</small></div>
      <div class="float f3"><span class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffc928" stroke-width="2"><path d="M3 17l6-6 4 4 8-8"/><path d="M14 7h7v7"/></svg></span><div><b style="font-size:16px;color:var(--ink)">احسان: ۲۶- کیلو در ۶ ماه</b><small>با حفظ عضله و وجود آسیب زانو</small></div></div>
    </div>
  </div>
</header>

<div class="stats">
  <div class="wrap">
    <div class="stat"><b data-n="15">۱۵<sup>+</sup></b><span>سال سابقهٔ مربی‌گری</span></div>
    <div class="stat"><b data-n="540">۵۴۰<sup>+</sup></b><span>ورزشکار حضوری و آنلاین</span></div>
    <div class="stat"><b data-n="385">۳۸۵<sup>+</sup></b><span>ویدئوی آموزشی اختصاصی</span></div>
    <div class="stat"><b data-n="1200">۱٬۲۰۰<sup>+</sup></b><span>دقیقه آموزش تکنیک</span></div>
  </div>
</div>

<section id="how">
  <div class="wrap center">
    <span class="tag"><i></i> روند کار</span>
    <h2 class="sec">از ارزیابی تا نتیجه، <em>در ۴ قدم</em></h2>
    <p class="lead">هیچ برنامهٔ آماده‌ای در کار نیست. همه‌چیز از شناخت بدن شما شروع می‌شود.</p>
