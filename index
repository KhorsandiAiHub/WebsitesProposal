const R={start:['پکیج پایه (START)','برنامهٔ تمرینی دقیق با ارزیابی و تمرینات اصلاحی؛ شروعی عالی.'],
pro:['پکیج پیشرفته (PRO)','تمرین + تغذیه + مکمل؛ سریع‌ترین مسیر رسیدن به نتیجه.'],
elite:['پکیج ویژه (ELITE)','ارتباط روزانه با شروین و تماس تصویری؛ نهایت همراهی.']};
document.querySelectorAll('.opt').forEach(o=>o.onclick=()=>{
  document.querySelectorAll('.opt').forEach(x=>x.classList.remove('on'));o.classList.add('on');
  const r=R[o.dataset.p],rec=document.getElementById('rec');
  rec.innerHTML='پیشنهاد ما: <b>'+r[0]+'</b><br><span style="color:var(--mute)">'+r[1]+'</span><br><a href="#plans" class="btn btn-y" style="margin-top:12px;padding:10px 20px;font-size:14px">مشاهدهٔ پکیج</a>';
  rec.classList.add('show');
});
// counters + reveal
const io=new IntersectionObserver(es=>es.forEach(e=>{
  if(!e.isIntersecting)return;const el=e.target;io.unobserve(el);
  if(el.dataset.n){const n=+el.dataset.n,sup=el.querySelector('sup').outerHTML;let s=performance.now();
    (function f(t){const k=Math.min((t-s)/1400,1),v=Math.round(n*(1-Math.pow(1-k,3)));el.innerHTML=fa(v)+sup;if(k<1)requestAnimationFrame(f)})(s);}
  else el.classList.add('in');
}),{threshold:.2});
document.querySelectorAll('[data-n],.reveal').forEach(el=>io.observe(el));
</script>
</body>
</html>
